# === Catch-Up Backend ===

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=catchup-hackathon
GOOGLE_CLOUD_LOCATION=europe-west1
# Auth: either GOOGLE_APPLICATION_CREDENTIALS path or run `gcloud auth application-default login`

# Gemini (via Vertex AI — no API key needed if gcloud auth is set)
# Or use Gemini API key directly:
# GOOGLE_API_KEY=AIza...

# Tavily
TAVILY_API_KEY=tvly-...

# Gradium (voice)
GRADIUM_API_KEY=grd_...

# LLM for Gradbot voice agent (can be Gemini or OpenAI-compatible).
# Point LLM_BASE_URL at our local /llm-proxy so the SSE response is patched
# before reaching gradbot (Gemini omits tool_call.index → gradbot drops the
# tool call → save_result never fires). The proxy forwards to
# https://generativelanguage.googleapis.com/v1beta/openai under the hood.
LLM_API_KEY=AIza...
LLM_BASE_URL=http://localhost:8000/llm-proxy
LLM_MODEL=gemini-2.5-flash
# Lighter model for structured extraction over long inputs (no thinking
# budget eating the response). Falls back to LLM_MODEL if unset.
LLM_LITE_MODEL=gemini-2.5-flash-lite

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=GOCSPX-...

# Public URLs (used to build the OAuth redirect_uri + bounce back to frontend)
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8080

# Server
PORT=8000
ENV=development
