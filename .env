# Catch-Up frontend — SHARED config + PRODUCTION fallback.
#
# Loading order (Vite): .env → .env.[mode] → .env.local → .env.[mode].local
#   - npm run dev    → mode=development, loads .env.development on top of this file
#   - npm run build  → mode=production, falls back to this file (no .env.production)
#
# Values here are public (Supabase anon key + Cloud Run public URL).
# Personal overrides go in .env.local (gitignored).

# Backend (Cloud Run) — overridden by .env.development for local dev.
VITE_API_BASE_URL=https://catchup-backend-157858425544.europe-west1.run.app
VITE_WS_BASE_URL=wss://catchup-backend-157858425544.europe-west1.run.app

