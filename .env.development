# Catch-Up frontend — DEVELOPMENT overrides.
#
# Auto-loaded by Vite when running `npm run dev`. Overrides values from .env.
# Personal tweaks (different port, etc.) go in .env.local — gitignored.

# Local backend (uvicorn dev server). Adjust the port to match yours.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ── Dev quick-login (skips SMS round-trip) ─────────────
#
# REQUIRES one-time Supabase setup:
#   Dashboard → Authentication → Phone Auth → "Test phone numbers"
#   Add a row:  phone = +33600000000   |   code = 123456
#
# Supabase will then accept that fixed OTP for that phone WITHOUT calling
# Twilio. The "Dev login" button in /onboarding/welcome uses these values.
VITE_DEV_PHONE=+33600000000
VITE_DEV_OTP=123456
